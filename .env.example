# Environment Variables for ReadIt Library
# Copy this to .env.local and fill in the values

# Next.js
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Authentication
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET="your-super-secret-key-change-this-in-production"

# Google OAuth (for Google Sign-In)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Email Service (for password reset, verification, notifications)
# Options: SMTP, SendGrid, Mailgun, SES, etc.
EMAIL_PROVIDER="smtp" # or sendgrid, mailgun, ses
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="your-email-username"
SMTP_PASS="your-email-password"
EMAIL_FROM="noreply@readitlibrary.com"

# Storage (for file uploads)
# Options: local, s3, gcs, etc.
STORAGE_PROVIDER="local" # or s3, gcs
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_REGION="us-east-1"
AWS_BUCKET_NAME="readit-library-storage"

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_PUSH_NOTIFICATIONS=false
NEXT_PUBLIC_ENABLE_OFFLINE_READING=true

# Admin
ADMIN_EMAIL="admin@readitlibrary.com"
ADMIN_PASSWORD="change-this-in-production"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000 # 1 minute
RATE_LIMIT_MAX_REQUESTS=60

# File Upload Limits
MAX_UPLOAD_SIZE=10485760 # 10MB
ALLOWED_FILE_TYPES="image/jpeg,image/png,application/pdf,text/plain"